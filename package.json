{
  "name": "crex-discord",
  "version": "0.1.0",
  "private": true,
  "description": "Bot crex: /anunciar y /editar solo para rol Crex Staff",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "register": "tsx src/register-commands.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
